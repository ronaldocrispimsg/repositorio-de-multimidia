map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Permitir uploads grandes vindos do frontend
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # Frontend estático (HTML/CSS/JS)
    location / {
        proxy_pass ${FRONTEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # APIs REST (prefixo /api) direcionadas ao backend Node.js/Express em streaming
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_request_buffering off;
    }

    # Streaming HLS (/streams/) servido pelo repository a partir do SeaweedFS Filer
    location /streams/ {
        proxy_pass ${REPOSITORY_UPSTREAM}/streams/;
        proxy_http_version 1.1;
    }

    # Painel de gerenciamento do RabbitMQ (HTTP + websockets)
    location /message/ {
        proxy_pass ${RABBIT_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
