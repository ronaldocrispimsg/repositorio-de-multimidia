map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Resolver DNS interno do Docker dinamicamente para não guardar cache de IPs antigos quando containers são recriados
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Permitir uploads grandes vindos do frontend
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # Frontend estático (HTML/CSS/JS)
    location / {
        set $frontend_upstream ${FRONTEND_UPSTREAM};
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # APIs REST (prefixo /api) direcionadas ao backend Node.js/Express em streaming
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_request_buffering off;
    }

    # Streaming HLS (/streams/) servido pelo repository a partir do SeaweedFS Filer
    location /streams/ {
        set $repository_upstream ${REPOSITORY_UPSTREAM};
        proxy_pass $repository_upstream;
        proxy_http_version 1.1;
    }

    # Mídias processadas de imagem e áudio (/media/) servidas pelo repository com cache imutável
    location /media/ {
        set $repository_upstream ${REPOSITORY_UPSTREAM};
        proxy_pass $repository_upstream;
        proxy_http_version 1.1;
    }

    # Painel de gerenciamento do RabbitMQ (HTTP + websockets)
    location /message/ {
        set $rabbit_upstream ${RABBIT_UPSTREAM};
        rewrite ^/message/(.*)$ /$1 break;
        proxy_pass $rabbit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
